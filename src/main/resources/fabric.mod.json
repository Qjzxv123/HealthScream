{
	"schemaVersion": 1,
	"id": "scream-mod",
	"version": "${version}",
	"name": "Heart Scream",
	"description": "A mod that screams at you when you're low on health!",
	"authors": [
		"Aidan McClain"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/scream-mod/icon.png",
	"environment": "*",
	"entrypoints": {
  "client": [
    "com.example.scream.ScreamMod"
  ],
  "modmenu": [
    "com.example.scream.ModMenuIntegration"
  ]
},
	"mixins": [
		"scream.mixins.json",
		{
			"config": "scream.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}